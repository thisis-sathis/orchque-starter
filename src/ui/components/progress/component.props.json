{
  "component": "Progress",
  "description": "Animated progress bar for uploads, onboarding steps, and loading states.",
  "props": {
    "value": { "type": "number", "required": false, "default": "0", "example": "65" },
    "max": { "type": "number", "required": false, "default": "100", "example": "100" },
    "label": { "type": "string", "required": false, "example": "\"Profile completion\"" },
    "showValue": { "type": "boolean", "required": false, "default": "false", "example": "true" },
    "size": { "type": "\"sm\" | \"md\" | \"lg\"", "required": false, "default": "\"md\"", "example": "\"sm\"" },
    "className": { "type": "string", "required": false, "example": "\"w-48\"" }
  }
}

{
  "component": "Toast",
  "description": "Notification system powered by Sonner. Place <Toaster /> once in root layout. Call toast() anywhere to show notifications.",
  "props": {
    "Toaster.position": { "type": "\"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"top-center\" | \"bottom-center\"", "required": false, "default": "\"bottom-right\"", "example": "\"top-right\"" },
    "Toaster.richColors": { "type": "boolean", "required": false, "example": "true" },
    "toast.message": { "type": "string", "required": true, "example": "\"Saved successfully\"" },
    "toast.type": { "type": "\"success\" | \"error\" | \"warning\" | \"info\"", "required": false, "example": "toast.success('Done')" }
  }
}

{
  "component": "Toggle",
  "description": "On/off switch atom. Radix Switch. Active state uses --color-primary.",
  "props": {
    "checked": { "type": "boolean", "required": false },
    "onCheckedChange": { "type": "function", "required": false, "description": "(checked: boolean) => void" },
    "label": { "type": "string", "required": false, "description": "Visible label text next to switch" },
    "id": { "type": "string", "required": false },
    "disabled": { "type": "boolean", "required": false },
    "className": { "type": "string", "required": false }
  }
}
